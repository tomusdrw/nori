package web

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"nori/internal/backup"
	"nori/internal/store"
)

templ backupPage(data backupPageData, csrf string) {
	@Layout("Backups", "Backups", csrf, backupScreen(data, csrf))
}

templ backupScreen(data backupPageData, csrf string) {
	<div class="backup-screen">@backupContent(data, csrf)</div>
}

templ backupContent(data backupPageData, csrf string) {
	if data.Service != nil {
		<div class="breadcrumb"><a href="/">← All services</a></div>
		<section class="page-heading"><h1>{ data.Service.Name }</h1></section>
		@serviceNavigation(data.Service.Name, "Backups", data.Service.IsSelf)
		@serviceBackupPolicy(*data.Service, data.Policy, data.Detected, csrf)
		@backupHistory(data.Jobs, data.S3.UploadEnabled(), csrf)
	} else {
		<section class="page-heading"><h1>Backups</h1></section>
		if len(data.Jobs) > 0 {
			@backupHistory(data.Jobs, data.S3.UploadEnabled(), csrf)
		}
		<div class="backup-tools">
			<section class="panel settings-panel">
				<div class="panel-heading">
					<div class="help-heading">
						<h2>Import a backup</h2>
						@sectionHelp("help-import", "How do I restore an archive?", "Choose an encrypted .nori file. Paste the private recovery key from the instance that created it if Nori doesn’t hold that key here. Review import lets you check the contents and choose a new service name before restoring.")
					</div>
				</div>
				<form method="post" action="/backups/import" enctype="multipart/form-data" class="panel-body">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<div class="field">
						<label for="backup-identity">Recovery key <span class="field-hint">· If the key is stored elsewhere</span></label>
						<input id="backup-identity" type="password" name="identity" autocomplete="off"/>
					</div>
					<div class="field">
						<label for="backup-file">Backup file</label>
						<input id="backup-file" type="file" name="archive" accept=".nori" required/>
					</div>
					<div class="panel-actions">
						<button class="button button-primary" type="submit">Review import</button>
						if data.S3.Enabled() {
							<a class="button button-secondary" href="/backups/s3">Browse remote backups</a>
						}
					</div>
				</form>
			</section>
			if len(data.Jobs) == 0 || data.KeyAvailable {
				<div class="backup-side">
					if len(data.Jobs) == 0 {
						@backupHistory(data.Jobs, data.S3.UploadEnabled(), csrf)
					}
					if data.KeyAvailable {
						<section class="panel settings-panel">
							<div class="panel-heading"><h2>Recovery key</h2></div>
							<div class="panel-body">
								<p>Store an exported key outside this server. You’ll need it to restore on another instance.</p>
								<form method="post" action="/backups/key">
									<input type="hidden" name="csrf_token" value={ csrf }/>
									<button class="button button-secondary" type="submit">Download recovery key</button>
								</form>
							</div>
						</section>
					}
				</div>
			}
		</div>
		<div class="backup-settings">
			@backupDiskSettings(data.Disks, data.DiskPolicy, csrf)
			@backupS3Settings(data.S3, csrf, data.S3Saved, "", "")
		</div>
	}
}

templ serviceBackupPolicy(svc store.Service, p store.BackupPolicy, detected []store.BackupSource, csrf string) {
	<section class="panel form-panel">
		<div class="panel-heading">
			<div class="help-heading">
				<h2>Backup policy</h2>
				@sectionHelp("help-policy", "What goes into a service backup?", "Each archive includes the saved service configuration and environment. Add filesystem sources for application files. For a running database such as SQLite, use paired export and import commands to make a consistent copy. Clear the schedule for manual backups.")
			</div>
			<form method="post" class="inline-form" action={ templ.SafeURL(serviceBackupsURL(svc.Name) + "/create") }>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<button class="button button-primary" type="submit">Create backup now</button>
			</form>
		</div>
		<form method="post" action={ templ.SafeURL(serviceBackupsURL(svc.Name)) } class="panel-body">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<div class="form-grid">
				<div class="field"><label for="backup-schedule">Schedule</label><input id="backup-schedule" name="schedule" value={ p.Schedule } placeholder="0 3 * * *"/><span class="field-help">Cron in the server’s timezone. Leave blank for manual backups.</span></div>
				<div class="field"><label for="backup-keep">Local copies to retain</label><input required id="backup-keep" type="number" min="1" max="100" name="keep" value={ strconv.Itoa(p.Keep) }/></div>
				<label><input name="local_only" type="checkbox" checked?={ p.LocalOnly }/> Store copies locally only</label>
				if svc.DeploymentMode == store.DeploymentModePostgres {
					<label><input name="skip_postgres" type="checkbox" checked?={ p.SkipPostgres }/> Exclude the managed PostgreSQL database</label>
				}
				if svc.DeploymentMode == store.DeploymentModePostgres || svc.DeploymentMode == store.DeploymentModeSingleContainer {
					<label><input name="stop_app" type="checkbox" checked?={ p.StopApp }/> Stop the managed application during data capture</label>
				}
				<div class="field field-wide">
					<label for="backup-sources">Filesystem sources</label>
					<textarea id="backup-sources" name="sources" rows="4" placeholder="volume app-data">{ backupSources(p.Sources) }</textarea>
					<span class="field-help">One per line. Use <code>volume NAME</code>, <code>managed LOGICAL_NAME</code> or <code>bind /absolute/path</code>.</span>
					if len(detected) > 0 {
						<details><summary>Detected mounts</summary><pre>{ backupSources(detected) }</pre></details>
					}
				</div>
			</div>
			<details class="backup-commands">
				<summary>Advanced backup commands</summary>
				<div class="form-grid">
					<div class="field"><label for="backup-quiesce">Quiesce command</label><textarea id="backup-quiesce" name="quiesce" rows="3">{ p.Quiesce }</textarea></div>
					<div class="field"><label for="backup-resume">Resume command</label><textarea id="backup-resume" name="resume" rows="3">{ p.Resume }</textarea></div>
					<div class="field"><label for="backup-export">Export command</label><textarea id="backup-export" name="export" rows="3">{ p.Export }</textarea></div>
					<div class="field"><label for="backup-import">Import command</label><textarea id="backup-import" name="import" rows="3">{ p.Import }</textarea></div>
				</div>
				<p class="field-help">Commands run with the service environment. Export writes to <code>$NORI_BACKUP_WORK</code> and import reads from it. Quiesce and resume must be safe to retry. Use the service dotenv for credentials.</p>
			</details>
			<div class="panel-actions"><button class="button button-primary" type="submit">Save backup policy</button></div>
		</form>
	</section>
}

templ backupHistory(jobs []store.BackupJob, s3 bool, csrf string) {
	<section class="panel detail-panel history-panel backup-history">
		<div class="panel-heading">
			<div class="help-heading">
				<h2>Backup history</h2>
				@sectionHelp("help-history", "How do I create a backup?", "Open Services, choose the service you want to protect, then open Backups. Choose Create backup now or save a schedule. Completed archives appear here for download or restore.")
			</div>
		</div>
		if len(jobs) == 0 {
			<div class="panel-body"><p>No backups yet.</p></div>
		} else {
			<div class="table-wrap">
				<table role="table">
					<thead role="rowgroup"><tr role="row"><th>Service</th><th>Created</th><th>Local archive</th><th>Remote storage</th><th>Actions</th></tr></thead>
					<tbody role="rowgroup">
						for _, job := range jobs {
							<tr role="row">
								<td role="cell" class="backup-job-service">{ job.ServiceName }</td>
								<td role="cell" class="backup-job-date">{ job.Created.Format("2006-01-02 15:04 MST") }</td>
								<td role="cell"><span class="backup-mobile-label">Local archive</span>{ job.Status }
									if job.Message != "" {
										<div>{ job.Message }</div>
									}
								</td>
								<td role="cell"><span class="backup-mobile-label">Remote storage</span>{ backupUploadStatus(job.UploadStatus) }</td>
								<td role="cell" class="backup-job-actions">
									if job.Status == "complete" {
										<div class="action-row">
											<a class="button button-secondary button-small" href={ templ.SafeURL(backupJobURL(job.ID) + "/download") }>Download</a>
											<form method="post" action={ templ.SafeURL(backupJobURL(job.ID) + "/import") } class="inline-form">
												<input type="hidden" name="csrf_token" value={ csrf }/>
												<button class="button button-secondary button-small" type="submit">Review restore</button>
											</form>
											if s3 && (job.UploadStatus == "retry" || job.UploadStatus == "failed") {
												<form method="post" action={ templ.SafeURL(backupJobURL(job.ID) + "/retry") } class="inline-form">
													<input type="hidden" name="csrf_token" value={ csrf }/>
													<button class="button button-secondary button-small" type="submit">Retry upload</button>
												</form>
											}
										</div>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ backupDiskSettings(disks []backup.DiskUsage, p backup.DiskPolicy, csrf string) {
	<section class="panel settings-panel" id="disk-space">
		<div class="panel-heading">
			<div class="help-heading">
				<h2>Disk space</h2>
				@sectionHelp("help-disk", "When do backups stop writing?", "Set the minimum free space to keep on each monitored filesystem. With warning levels of 15% and 5 GiB, falling below either value sends an alert. A critical reading on any monitored filesystem defers backup writes.")
			</div>
			<a class="panel-link" href="/resources">View resources →</a>
		</div>
		<form method="post" action="/backups/disks" class="panel-body">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			for _, disk := range disks {
				<div class="disk-usage">
					<div><code>{ disk.Path }</code><span>{ disk.Status }</span></div>
					if disk.Total > 0 {
						<meter aria-label={ "Used space on " + disk.Path } min="0" max={ strconv.FormatInt(disk.Total, 10) } value={ strconv.FormatInt(disk.Total - disk.Available, 10) }></meter>
					}
					<small>{ fmt.Sprintf("%.1f GiB of %.1f GiB free", float64(disk.Available)/float64(backup.GiB), float64(disk.Total)/float64(backup.GiB)) }</small>
				</div>
			}
			<div class="form-grid">
				<div class="field"><label for="backup-wp">Warning threshold (%)</label><input id="backup-wp" name="warning_percent" type="number" min="0" max="95" required value={ strconv.FormatInt(p.WarningPercent, 10) }/></div>
				<div class="field"><label for="backup-wb">Warning threshold (GiB)</label><input id="backup-wb" name="warning_gib" type="number" min="0" required value={ strconv.FormatInt(p.WarningBytes / backup.GiB, 10) }/></div>
				<div class="field"><label for="backup-cp">Critical threshold (%)</label><input id="backup-cp" name="critical_percent" type="number" min="0" max="95" required value={ strconv.FormatInt(p.CriticalPercent, 10) }/></div>
				<div class="field"><label for="backup-cb">Critical threshold (GiB)</label><input id="backup-cb" name="critical_gib" type="number" min="0" required value={ strconv.FormatInt(p.CriticalBytes / backup.GiB, 10) }/></div>
				<div class="field field-wide"><label for="backup-paths">Additional paths to monitor</label><textarea id="backup-paths" name="paths" rows="3">{ strings.Join(p.Paths, "\n") }</textarea><span class="field-help">One absolute path per line, visible from Nori.</span></div>
			</div>
			<p class="field-help">Either threshold can trigger an alert through configured administrator notification channels.</p>
			<div class="panel-actions"><button class="button button-primary" type="submit">Save disk thresholds</button></div>
		</form>
	</section>
}

templ backupS3SettingsErrorPage(c backup.S3Config, csrf, message, field string) {
	@Layout("S3 backup storage settings", "Backups", csrf, backupS3SettingsErrorContent(c, csrf, message, field))
}

templ backupS3SettingsErrorContent(c backup.S3Config, csrf, message, field string) {
	<div class="breadcrumb"><a href="/backups#s3-storage">← Backups</a></div>
	<div class="backup-screen">
		@backupS3Settings(c, csrf, false, message, field)
	</div>
}

templ backupS3Settings(c backup.S3Config, csrf string, saved bool, message, errorField string) {
	<section class="panel settings-panel" id="s3-storage">
		<div class="panel-heading">
			<div class="help-heading">
				<h2>S3 backup storage</h2>
				@sectionHelp("help-s3", "How do I connect a bucket?", "Use your provider’s S3 service endpoint, signing region and bucket credentials. The key needs permission to list and read objects for imports, and write objects for uploads. Set remote retention in your provider’s bucket lifecycle rules.")
			</div>
		</div>
		<form method="post" action="/backups/s3" class="panel-body" id="s3-settings-form" autocomplete="off">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<div class="alert alert-error s3-feedback" id="s3-save-error" role="alert" tabindex="-1" hidden?={ message == "" } autofocus?={ message != "" && errorField == "" }>{ message }</div>
			if saved {
				<div class="alert alert-success s3-feedback" id="s3-save-success" role="status">
					S3 settings saved.
					if c.Enabled() {
						<a class="panel-link" href="/backups/s3">Check access by browsing backups →</a>
					}
				</div>
			}
			<div class="form-grid">
				<div class="field field-wide">
					<label for="s3-endpoint">S3 endpoint URL</label>
					<input id="s3-endpoint" name="endpoint" inputmode="url" value={ c.Endpoint } placeholder="https://s3.us-west-2.amazonaws.com" spellcheck="false" { s3FieldAttributes("endpoint", errorField)... }/>
					<span class="field-help" id="s3-help-endpoint">Use your provider’s S3 service URL. Nori adds the bucket name using the addressing option below.</span>
				</div>
				<div class="field">
					<label for="s3-bucket">Bucket name</label>
					<input id="s3-bucket" name="bucket" value={ c.Bucket } placeholder="my-private-backups" spellcheck="false" { s3FieldAttributes("bucket", errorField)... }/>
					<span class="field-help" id="s3-help-bucket">Copy the bucket name from your storage provider. Leave blank to turn off remote storage.</span>
				</div>
				<div class="field">
					<label for="s3-region">S3 signing region</label>
					<input id="s3-region" name="region" value={ c.Region } placeholder="us-west-2" spellcheck="false" { s3FieldAttributes("region", errorField)... }/>
					<span class="field-help" id="s3-help-region">Use the signing region listed by your storage provider.</span>
				</div>
				<div class="field field-wide">
					<label for="s3-prefix">Backup object prefix</label>
					<input id="s3-prefix" name="prefix" value={ c.Prefix } placeholder="nori" spellcheck="false" { s3FieldAttributes("prefix", errorField)... }/>
					<span class="field-help" id="s3-help-prefix">Choose a folder-like path inside the bucket, such as <code>nori</code>. To browse existing backups, use the prefix they were saved under.</span>
				</div>
				<div class="field">
					<label for="s3-key-id">Access key ID</label>
					<input id="s3-key-id" name="access_key_id" value={ c.AccessKeyID } spellcheck="false" { s3FieldAttributes("access_key_id", errorField)... }/>
					<span class="field-help" id="s3-help-access_key_id">Use the key ID for a credential with access to the bucket.</span>
				</div>
				<div class="field">
					<label for="s3-secret-key">Secret access key</label>
					<input id="s3-secret-key" type="password" name="secret_access_key" autocomplete="new-password" { s3FieldAttributes("secret_access_key", errorField)... }/>
					<span class="field-help" id="s3-help-secret_access_key">Leave blank to reuse the secret for the same destination and access key ID.</span>
				</div>
			</div>
			<div class="check-options">
				<div>
					<label><input name="virtual_hosted" type="checkbox" aria-describedby="s3-addressing-help" checked?={ c.VirtualHosted }/> Prefer bucket name in hostname</label>
					<span class="field-help" id="s3-addressing-help">Enable for virtual-hosted-style URLs like <code>bucket.s3.example.com</code>. Leave off for path-style URLs like <code>s3.example.com/bucket</code>.</span>
				</div>
				<label><input name="disabled" type="checkbox" checked?={ c.Disabled }/> Pause remote storage access</label>
				<label><input name="read_only" type="checkbox" checked?={ c.ReadOnly }/> Use remote storage for imports only</label>
			</div>
			<div class="panel-actions"><button class="button button-primary" type="submit">Save S3 settings</button></div>
		</form>
	</section>
	<script src="/static/backup-s3-settings.js" type="module"></script>
}

templ backupS3Page(objects []string, next, csrf, message string) {
	@Layout("Remote backups", "Backups", csrf, backupS3Content(objects, next, csrf, message))
}

templ backupS3Content(objects []string, next, csrf, message string) {
	<div class="breadcrumb"><a href="/backups">← Backups</a></div>
	<section class="page-heading"><h1>Remote backups</h1></section>
	<section class="panel archive-picker">
		<div class="panel-heading"><h2>Select an archive</h2></div>
		<div class="panel-body">
			if message != "" {
				<div class="alert alert-error s3-feedback" role="alert">{ message }</div>
				<div class="panel-actions">
					<a class="button button-secondary" href="/backups#s3-storage">Edit S3 settings</a>
				</div>
			} else if len(objects) > 0 {
				<form method="post" action="/backups/s3/import" class="service-form">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<div class="field"><label for="s3-object">Backup object</label>
						<select id="s3-object" name="key" required>
							for _, object := range objects {
								<option value={ object }>{ object }</option>
							}
						</select>
					</div>
					<div class="field"><label for="s3-identity">Recovery key for a different instance</label><input id="s3-identity" type="password" name="identity" autocomplete="off"/></div>
					<div class="panel-actions"><button class="button button-primary" type="submit">Review import</button></div>
				</form>
			} else {
				<p>No backup archives on this page under the configured object prefix.</p>
			}
			if next != "" {
				<a href={ templ.SafeURL("/backups/s3?cursor=" + url.QueryEscape(next)) }>next page →</a>
			}
		</div>
	</section>
}

templ backupReviewPage(manifest backup.Manifest, options backup.RestoreOptions, token, csrf, errorMessage, errorField string) {
	@Layout("Review restore", "Backups", csrf, backupReviewScreen(manifest, options, token, csrf, errorMessage, errorField))
}

templ backupReviewScreen(manifest backup.Manifest, options backup.RestoreOptions, token, csrf, errorMessage, errorField string) {
	<div class="backup-screen">@backupReviewContent(manifest, options, token, csrf, errorMessage, errorField)</div>
}

templ backupReviewContent(manifest backup.Manifest, options backup.RestoreOptions, token, csrf, errorMessage, errorField string) {
	<div class="breadcrumb"><a href="/backups">← Backups</a></div>
	<section class="page-heading"><h1>Restore { manifest.Service.Name }</h1></section>
	if errorMessage != "" {
		<div class="alert alert-error" role="alert" id="restore-error" tabindex="-1" autofocus?={ errorField == "" }>
			if errorField != "" {
				<a href={ templ.SafeURL("#restore-" + errorField) }>{ errorMessage }</a>
			} else {
				{ errorMessage }
			}
		</div>
	}
	<section class="panel settings-panel">
		<div class="panel-heading"><h2>Archive contents</h2></div>
		<div class="panel-body restore-summary">
			<p>This backup contains service configuration and its environment document.</p>
			if _, exists := manifest.Files["postgres"]; exists {
				<p>Managed PostgreSQL dump
					if timestamp := manifest.Captured["postgres"]; !timestamp.IsZero() {
						<span>· { timestamp.Local().Format("2006-01-02 15:04 MST") }</span>
					}
				</p>
				if manifest.Postgres != nil {
					<p>Source PostgreSQL major version { strconv.Itoa(manifest.Postgres.ServerVersion / 10000) }</p>
				}
			}
			if manifest.Service.WatchedImage != "" {
				<p>Application image <code>{ manifest.Service.WatchedImage }</code> { manifest.Digest }</p>
			}
		</div>
	</section>
	<section class="panel settings-panel">
		<div class="panel-heading"><h2>Restore destination</h2></div>
		<form method="post" action={ templ.SafeURL("/backups/restore/" + token) } class="panel-body">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<div class="form-grid">
				<div class="field"><label for="restore-name">New service name</label><input id="restore-name" name="name" required value={ options.Name } { restoreErrorAttributes(errorField, "name")... }/></div>
				if manifest.Service.DeploymentMode == store.DeploymentModePostgres || manifest.Service.DeploymentMode == store.DeploymentModeSingleContainer {
					<div class="field"><label for="restore-network">Override serving network</label><input id="restore-network" name="network" value={ options.Network } { restoreErrorAttributes(errorField, "network")... }/></div>
					<div class="field"><label for="restore-domain">Override proxy domain</label><input id="restore-domain" name="domain" value={ options.Domain } { restoreErrorAttributes(errorField, "domain")... }/></div>
				} else {
					<div class="field field-wide"><label for="restore-script">Deployment script</label><textarea id="restore-script" name="deploy_script" rows="8" { restoreErrorAttributes(errorField, "script")... }>if options.DeployScript != nil {
						{ *options.DeployScript }
					}</textarea></div>
				}
				for i, source := range manifest.Policy.Sources {
					if source.Type == "managed" {
						<p>Managed volume <code>{ source.Path }</code> will be restored into a new volume.</p>
					} else {
						<div class="field"><label for={ "restore-target-" + strconv.Itoa(i) }>New destination for <code>{ source.Type + " " + source.Path }</code></label><input id={ "restore-target-" + strconv.Itoa(i) } name={ "target_" + strconv.Itoa(i) } required value={ options.Targets[i] } { restoreErrorAttributes(errorField, "target-" + strconv.Itoa(i))... }/>
							if timestamp := manifest.Captured["source-" + strconv.Itoa(i)]; !timestamp.IsZero() {
								<span class="field-help">Captured { timestamp.Local().Format("2006-01-02 15:04 MST") }</span>
							}
						</div>
					}
				}
				if manifest.Policy.Import != "" || manifest.Policy.Resume != "" {
					<div class="field field-wide">
						<details><summary>Review backup commands</summary>
							if manifest.Policy.Import != "" {
								<h3>Import</h3><pre>{ manifest.Policy.Import }</pre>
							}
							if manifest.Policy.Export != "" {
								<h3>Export</h3><pre>{ manifest.Policy.Export }</pre>
							}
							if manifest.Policy.Resume != "" {
								<h3>Resume</h3><pre>{ manifest.Policy.Resume }</pre>
							}
							if manifest.Policy.Quiesce != "" {
								<h3>Quiesce</h3><pre>{ manifest.Policy.Quiesce }</pre>
							}
						</details>
						<label><input id="restore-commands" name="reviewed" type="checkbox" checked?={ options.ReviewCommands } { restoreErrorAttributes(errorField, "commands")... }/> I reviewed these commands and authorize them on this host</label>
					</div>
				}
			</div>
			<div class="panel-actions">
				<button class="button button-secondary" type="submit" form="restore-cancel">Cancel</button>
				<button class="button button-primary" type="submit">Restore as new service</button>
			</div>
		</form>
		<form id="restore-cancel" method="post" action={ templ.SafeURL("/backups/restore/" + token) }>
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<input type="hidden" name="cancel" value="1"/>
		</form>
	</section>
}

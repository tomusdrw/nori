package web

import "strconv"

templ ServiceDetailPage(data ServiceDetailData, csrf string) {
	@Layout(data.Service.Name, "Services", csrf, serviceDetailContent(data, csrf))
}

templ serviceDetailContent(data ServiceDetailData, csrf string) {
	<div class="breadcrumb"><a href="/">← All services</a></div>
	<section class="detail-heading">
		<div class="service-intro">
			<h1>{ data.Service.Name }</h1>
			<div class="service-identifiers">
				<span class={ "badge badge-state badge-state-" + data.State }><span class={ "status-dot status-" + data.State }></span>
					if data.State == "none" {
						No containers
					} else {
						{ data.State }
					}
				</span>
				if data.Service.IsSelf {
					<span class="service-tag">Managed</span>
				}
				if data.Service.ManualScript {
					<span class="service-tag">Manual deployment</span>
				} else {
					<code>{ data.Service.WatchedImage }</code>
				}
			</div>
			if data.Service.Description != "" {
				<p class="service-description">{ data.Service.Description }</p>
			}
		</div>
		<div class="action-row">
			<form method="post" action={ templ.SafeURL("/services/" + data.Service.Name + "/deploy") } class="inline-form">
				<input type="hidden" name="csrf_token" value={ csrf }/>
				if data.UpdateAvail {
					<button class="button button-primary" type="submit">Update</button>
				} else if data.Service.ManualScript {
					<button class="button button-secondary" type="submit">Run script</button>
				} else {
					<button class="button button-secondary" type="submit">Re-deploy</button>
				}
			</form>
		</div>
	</section>
	@serviceNavigation(data.Service.Name, "Overview", data.Service.IsSelf)
	<dl class="dashboard-summary service-summary">
		<div><dt>Running for</dt><dd>{ data.RunningFor }</dd></div>
		<div><dt>Last deploy</dt><dd>{ data.LastDeploy }</dd></div>
		if data.Service.ManualScript {
			<div><dt>Containers</dt><dd>{ strconv.Itoa(len(data.Containers)) }</dd></div>
		} else {
			<div><dt>Image versions</dt><dd>
				<code title="Running image">{ data.Running }</code>
				if data.Running != data.Latest {
					<span aria-label="Latest image"> → </span><code>{ data.Latest }</code>
				}
			</dd>
			if data.UpdateAvail {
				<span class="service-tag update-tag">Update available</span>
			}
			</div>
		}
	</dl>
	<div class="service-runtime">
		<section id="logs" class="panel detail-panel log-panel service-log-panel" data-log-panel hx-request='{"timeout":8000}'>
			<div class="panel-heading compact-heading">
				<div><h2>Container logs</h2><p>The latest 100 lines from the selected container.</p></div>
				<div class="heading-side">
					<button class="log-copy button button-ghost button-small" type="button" onclick="copyContainerLogs(this)">Copy</button>
					@logConnection()
				</div>
			</div>
			<div id="container-logs" data-log-refresh hx-get={ logsStreamURL(data.Service.Name, "") } hx-trigger="load, every 3s" hx-swap="outerHTML" hx-sync="#logs:drop">Loading logs…</div>
		</section>

		<section class="panel detail-panel containers-panel">
			<div class="panel-heading compact-heading">
				<div><h2>Containers</h2></div>
				<span class="count-pill">{ strconvItoa(len(data.Containers)) }</span>
			</div>
			if len(data.Containers) == 0 {
				<div class="panel-body"><p>No labeled containers found.</p></div>
			} else {
				<ul class="container-list">
					for _, c := range data.Containers {
						<li><strong>{ c.Name }</strong><span class="service-state"><span class={ "status-dot status-" + c.State }></span>{ c.State }</span><code>{ c.Image }</code></li>
					}
				</ul>
			}
			<div class="container-actions">
				<form method="post" action={ templ.SafeURL("/services/" + data.Service.Name + "/start") } class="inline-form">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<button class="button button-secondary button-small" type="submit">Start</button>
				</form>
				<form method="post" action={ templ.SafeURL("/services/" + data.Service.Name + "/stop") } class="inline-form">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<button class="button button-secondary button-small" type="submit">Stop</button>
				</form>
			</div>
		</section>
	</div>
	<section class="panel detail-panel history-panel service-records">
		<div class="panel-heading compact-heading">
			<div><h2>Deployment history</h2></div>
			<span class="count-pill">{ strconvItoa(len(data.Deployments)) }</span>
		</div>
		<div class="table-wrap">
			<table>
				<thead><tr><th>Deployment</th><th>Trigger</th><th>Target</th><th>Status</th><th>Started</th></tr></thead>
				<tbody>
					if len(data.Deployments) == 0 {
						<tr><td colspan="5" class="empty-cell">No deployments yet.</td></tr>
					}
					for _, d := range data.Deployments {
						<tr>
							<td class="table-primary"><a href={ templ.SafeURL("/deployments/" + strconvItoa64(d.ID)) }>#{ strconvItoa64(d.ID) }</a></td>
							<td data-label="Trigger">{ d.Trigger }</td>
							<td data-label="Target"><code>{ shortDigest(d.TargetDigest) }</code></td>
							<td data-label="Status"><span class={ "badge badge-deploy badge-deploy-" + d.Status }>{ d.Status }</span></td>
							<td data-label="Started">{ d.StartedAt }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>

	<script>
		function copyContainerLogs(btn) {
			var box = document.querySelector('#container-logs .log-box');
			var text = box ? box.textContent : '';
			var done = function(ok) {
				btn.textContent = ok ? 'Copied' : 'Failed';
				setTimeout(function() { btn.textContent = 'Copy'; }, 1500);
			};
			// The dashboard is often served over plain HTTP (e.g. a tailnet
			// IP), where navigator.clipboard is unavailable and the
			// deprecated execCommand path is the only way to copy.
			var fallback = function() {
				var ta = document.createElement('textarea');
				ta.value = text;
				ta.style.position = 'fixed';
				ta.style.opacity = '0';
				document.body.appendChild(ta);
				ta.select();
				var ok = false;
				try { ok = document.execCommand('copy'); } catch (e) {}
				ta.remove();
				done(ok);
			};
			if (navigator.clipboard && window.isSecureContext) {
				navigator.clipboard.writeText(text).then(function() { done(true); }, fallback);
			} else {
				fallback();
			}
		}
	</script>
}

templ serviceNavigation(name, active string, self bool) {
	<nav class="service-nav" aria-label="Service navigation">
		for _, item := range []struct{label, suffix string}{
			{"Overview", ""}, {"Resources", "/resources"}, {"Backups", "/backups"}, {"Configure", "/edit"},
		} {
			if item.label != "Backups" || !self {
				<a href={ templ.SafeURL("/services/" + name + item.suffix) }
					if item.label == active {
						aria-current="page"
					}
				>{ item.label }</a>
			}
		}
	</nav>
}

func strconvItoa64(i int64) string {
	return strconvItoa(int(i))
}

// containerLogsFragment is the service detail page's log panel body: a tab per
// container when there are several, above the selected container's log tail.
// Tab clicks re-request this fragment, so the active highlight is rendered
// server-side and the wrapper id stays stable across swaps.
templ containerLogsFragment(service string, names []string, selected string, logs string) {
	<div id="container-logs" data-log-refresh data-log-container={ selected } hx-get={ logsStreamURL(service, selected) } hx-trigger="every 3s" hx-swap="outerHTML" hx-sync="#logs:drop">
		if len(names) > 1 {
			<div class="log-tabs" role="tablist">
				for _, name := range names {
					<button class={ "log-tab", templ.KV("active", name == selected) } aria-selected={ strconv.FormatBool(name == selected) } hx-get={ logsStreamURL(service, name) } id={ "log-tab-" + name } hx-target="#container-logs" hx-swap="outerHTML" hx-sync="#logs:replace">{ name }</button>
				}
			</div>
		}
		if logs == "" {
			<pre class="log-box">No container logs yet.</pre>
		} else {
			<pre class="log-box">{ logs }</pre>
		}
	</div>
}

templ logConnection() {
	<div class="log-connection" data-log-connection data-state="checking">
		<span class="status-dot" aria-hidden="true"></span>
		<div>
			<div data-log-message role="status">Checking for updates…</div>
			<div data-log-checked hidden></div>
		</div>
	</div>
}

templ DeploymentPage(progress deploymentProgressView, csrf string) {
	@Layout("Deployment", "Services", csrf, deploymentContent(progress))
}

templ deploymentContent(progress deploymentProgressView) {
	<div class="breadcrumb"><a href="/">← Dashboard</a></div>
	<section class="page-heading">
		<div>
			<h1>Deployment #{ strconvItoa64(progress.ID) }</h1>
			<p class="page-subtitle">Combined output from the deployment script.</p>
		</div>
	</section>
	<section class="panel detail-panel log-panel deployment-log-panel" data-log-panel hx-request='{"timeout":8000}'>
		<div class="panel-heading compact-heading">
			<h2>Output</h2>
			if progress.Poll {
				@logConnection()
			}
		</div>
		@deploymentLog(progress)
	</section>
}

templ deploymentLog(progress deploymentProgressView) {
	<div id="deploy-log" data-log-refresh
		if progress.Poll {
			hx-get={ templ.SafeURL("/deployments/" + strconvItoa64(progress.ID) + "/stream") }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		<div class="deployment-log-meta">
			<span class={ "badge badge-deploy badge-deploy-" + progress.Status }>{ progress.Status }</span>
			if progress.Elapsed != "" {
				<span>Elapsed { progress.Elapsed }</span>
			}
			if progress.Explanation != "" {
				<span>{ progress.Explanation }</span>
			}
		</div>
		if progress.Log != "" {
			<pre class="log-box log-box-large">{ progress.Log }</pre>
		} else if progress.Poll {
			<pre class="log-box log-box-large">No output available yet.</pre>
		} else {
			<pre class="log-box log-box-large">No deployment output.</pre>
		}
	</div>
}

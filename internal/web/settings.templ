package web

templ SettingsPage(botName string, notifyMode string, csrf string, errMsg string, saved bool) {
	@Layout("Settings", csrf, settingsContent(botName, notifyMode, csrf, errMsg, saved))
}

templ settingsContent(botName string, notifyMode string, csrf string, errMsg string, saved bool) {
	<section class="page-heading form-heading">
		<div>
			<p class="eyebrow">Instance</p>
			<h1>Settings</h1>
			<p class="page-subtitle">Customize how this Nori instance appears in the dashboard and browser tab.</p>
		</div>
	</section>
	if errMsg != "" {
		<div class="alert alert-error" role="alert">
			<strong>Couldn’t save</strong>
			<span>{ errMsg }</span>
		</div>
	}
	if saved {
		<div class="alert alert-success" role="status">
			<strong>Saved</strong>
			<span>Settings updated. Open tabs will reflect the change after refresh.</span>
		</div>
	}
	<form method="post" action="/settings" class="service-form">
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<section class="panel form-panel">
			<div class="panel-heading">
				<div>
					<h2>Display name</h2>
					<p>Shown in the top bar and page title so you can tell instances apart across browser tabs.</p>
				</div>
				<span class="step-number">01</span>
			</div>
			<div class="form-grid">
				<div class="field">
					<label for="bot-name">Bot name</label>
					<input id="bot-name" name="bot_name" value={ botName } required maxlength="64" placeholder="Nori" autofocus/>
					<span class="field-help">Up to 64 characters. Does not change the internal <code>deploybot</code> service name.</span>
				</div>
			</div>
		</section>
		<section class="panel form-panel">
			<div class="panel-heading">
				<div>
					<h2>Notifications</h2>
					<p>When to send an SMS when a deploy fails. Requires Twilio to be configured via <code>DEPLOYBOT_TWILIO_*</code> env vars.</p>
				</div>
				<span class="step-number">02</span>
			</div>
			<div class="form-grid">
				<div class="field">
					<label for="notify-mode">SMS on deploy failure</label>
					<select id="notify-mode" name="notify_mode">
						<option value="always" selected?={ notifyMode == "always" }>Always (manual + automatic)</option>
						<option value="auto-only" selected?={ notifyMode == "auto-only" }>Automatic deployments only</option>
						<option value="never" selected?={ notifyMode == "never" }>Never</option>
					</select>
					<span class="field-help">Automatic retries are already deduped per image digest during the failure cooldown; manual deploys are not deduped.</span>
				</div>
			</div>
		</section>
		<div class="form-actions">
			<button class="button button-primary" type="submit">Save settings</button>
		</div>
	</form>
}


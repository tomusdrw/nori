package web

import (
	"fmt"
	"strconv"
	"strings"
)

templ Page(dashboard dashboardView, csrf string) {
	@Layout("Services", csrf, dashboardContent(dashboard, csrf))
}

templ dashboardContent(dashboard dashboardView, csrf string) {
	<script src="/static/service-groups.js" type="module"></script>
	<section class="page-heading">
		<div>
			<p class="eyebrow">Overview</p>
			<h1>Your services</h1>
			<p class="page-subtitle">Live health, image versions, and deployments in one place.</p>
		</div>
		<div class="heading-meta">
			<span class="live-indicator"><span class="pulse-dot"></span> Live</span>
			<span>{ serviceCountLabel(dashboard.Count) }</span>
		</div>
	</section>
	<span id="group-reorder-help" class="group-screen-reader">Drag to reorder, or use the up and down arrow keys.</span>
	<p id="group-reorder-status" class="group-screen-reader" role="status" hx-sync="#services:replace"></p>
	@ServicesTablePartial(dashboard, csrf)
}

templ ServicesTablePartial(dashboard dashboardView, csrf string) {
	<div id="services" class="dashboard-groups" hx-get="/partials/services" hx-trigger="every 5s" hx-swap="outerHTML">
		if dashboard.Count == 0 {
			<section class="empty-state panel">
				<div class="empty-icon">+</div>
				<h2>No services yet</h2>
				<p>Add your first service to start watching images and deploying from the dashboard.</p>
				<a class="button button-primary" href="/services/new">Create a service</a>
			</section>
		}
		for _, group := range dashboard.Groups {
			@dashboardGroupSection(group, csrf, len(dashboard.Groups) > 1)
		}
	</div>
}

templ dashboardGroupSection(group dashboardGroup, csrf string, canMove bool) {
	<section id={ serviceGroupAnchor(group.ID) } class="dashboard-group" data-group-id={ strconv.FormatInt(group.ID, 10) }>
		<header class="dashboard-group-header panel">
			<div class="dashboard-group-heading">
				<form method="post" action={ templ.SafeURL(serviceGroupURL(group.ID) + "/fold") } hx-post={ serviceGroupURL(group.ID) + "/fold" } hx-target="#services" hx-swap="outerHTML" hx-sync="#services:replace">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<input type="hidden" name="collapsed" value={ strconv.FormatBool(!group.Collapsed) }/>
					<h2>
						<button type="submit" class="dashboard-group-toggle" id={ serviceGroupAnchor(group.ID) + "-toggle" } aria-expanded={ strconv.FormatBool(!group.Collapsed) } aria-controls={ serviceGroupAnchor(group.ID) + "-services" }>
							<span class="group-chevron" aria-hidden="true">▸</span>
							<span>{ group.Name }</span>
						</button>
					</h2>
				</form>
				<span class="dashboard-group-count">{ serviceCountLabel(len(group.Services)) }</span>
				if group.Collapsed && len(group.Services) > 0 {
					<div class="dashboard-group-status" aria-label="Service status">
						for _, status := range group.statuses() {
							<span><span class={ "status-dot status-" + status.State } aria-hidden="true"></span>{ fmt.Sprintf("%d %s", status.Count, status.Label) }</span>
						}
					</div>
				}
			</div>
			if canMove {
				<button type="button" class="button button-ghost button-small dashboard-group-handle" id={ serviceGroupAnchor(group.ID) + "-move" } data-group-move={ serviceGroupURL(group.ID) + "/move" } aria-label={ "Reorder " + group.Name } aria-describedby="group-reorder-help" title="Drag to reorder">
					<span aria-hidden="true">⠿</span>
				</button>
			}
		</header>
		<div id={ serviceGroupAnchor(group.ID) + "-services" } hidden?={ group.Collapsed }>
			if !group.Collapsed {
				if len(group.Services) == 0 {
					<p class="dashboard-group-empty">No services in this group.</p>
				} else {
					@serviceCards(group.Services, csrf)
				}
			}
		</div>
	</section>
}

templ serviceCards(views []ServiceView, csrf string) {
	<div class="service-grid">
		for _, v := range views {
			<article class="service-card">
				<div class="service-card-top">
					<div class="service-identity">
						<div class="service-avatar">{ serviceInitial(v.Name) }</div>
						<div>
							<a class="service-name" href={ templ.SafeURL("/services/" + v.Name) }>{ v.Name }</a>
							<div class="service-state"><span class={ "status-dot status-" + v.State }></span>{ v.State }</div>
						</div>
					</div>
					if v.Managed {
						<span class="badge badge-update">managed</span>
					}
					if v.ManualScript {
						<span class="badge badge-manual">Manual deployment</span>
					}
					if v.UpdateAvailable {
						<span class="badge badge-update">update available</span>
					}
				</div>
				<div class="service-metrics">
					<div>
						<span class="metric-label">Running for</span>
						<strong>{ v.RunningFor }</strong>
					</div>
					<div>
						<span class="metric-label">Last deploy</span>
						<strong>{ v.LastDeploy }</strong>
					</div>
				</div>
				if !v.ManualScript {
					<div class="version-summary" title="Running and latest image digests">
						<span>Image</span><code>{ v.RunningVersion }</code><span>→</span><code>{ v.LatestVersion }</code>
					</div>
				}
				<div class="dashboard-log-preview">
					<div class="log-preview-heading"><span class="metric-label">Recent logs</span><a href={ templ.SafeURL("/services/" + v.Name + "#logs") }>Open full logs</a></div>
					<pre>{ v.RecentLogs }</pre>
				</div>
				<div class="service-card-actions">
					<form method="post" action={ templ.SafeURL("/services/" + v.Name + "/deploy") } class="inline-form">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						if v.ManualScript {
							<button class="button button-secondary button-small" type="submit">Run script</button>
						} else if v.UpdateAvailable {
							<button class="button button-primary button-small" type="submit">Update</button>
						} else {
							<button class="button-redeploy" type="submit">Re-deploy</button>
						}
					</form>
					<a class="button button-secondary button-small" href={ templ.SafeURL("/services/" + v.Name) }>Details</a>
				</div>
			</article>
		}
	</div>
}

func serviceInitial(name string) string {
	if name == "" {
		return "?"
	}
	runes := []rune(name)
	return strings.ToUpper(string(runes[0]))
}

func serviceCountLabel(count int) string {
	if count == 1 {
		return "1 service"
	}
	return fmt.Sprintf("%d services", count)
}

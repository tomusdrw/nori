# Copy to .env and fill in before: docker compose up -d
#
# Generate values:
#   NORI_KEY=$(head -c 32 /dev/urandom | base64)
#   NORI_SESSION_KEY=$(head -c 32 /dev/urandom | base64)
#   NORI_ADMIN_HASH=$(docker run --rm ghcr.io/tomusdrw/nori:latest hash-password 'your-password')

NORI_KEY=
NORI_SESSION_KEY=
NORI_ADMIN_HASH=
NORI_PORT=8080
NORI_POLL_INTERVAL=60s
NORI_MONITOR_INTERVAL=60s

# Optional: SMS alerts on deploy failure via Twilio.
# Leave all four blank to disable. Setting only some of them is an error.
#   NORI_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   NORI_TWILIO_AUTH_TOKEN=your_twilio_auth_token
#   NORI_TWILIO_FROM=+15551234567     # a Twilio-owned number
#   NORI_TWILIO_TO=+15559876543       # the on-call recipient

# Copy to .env and fill in before: docker compose up -d
#
# Generate values:
#   DEPLOYBOT_KEY=$(head -c 32 /dev/urandom | base64)
#   DEPLOYBOT_SESSION_KEY=$(head -c 32 /dev/urandom | base64)
#   DEPLOYBOT_ADMIN_HASH=$(docker run --rm ghcr.io/tomusdrw/nori:latest hash-password 'your-password')

DEPLOYBOT_KEY=
DEPLOYBOT_SESSION_KEY=
DEPLOYBOT_ADMIN_HASH=
DEPLOYBOT_PORT=8080
DEPLOYBOT_POLL_INTERVAL=60s

# Optional: SMS alerts on deploy failure via Twilio.
# Leave all four blank to disable. Setting only some of them is an error.
#   DEPLOYBOT_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   DEPLOYBOT_TWILIO_AUTH_TOKEN=your_twilio_auth_token
#   DEPLOYBOT_TWILIO_FROM=+15551234567     # a Twilio-owned number
#   DEPLOYBOT_TWILIO_TO=+15559876543       # the on-call recipient
